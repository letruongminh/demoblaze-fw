# Copy to .env and adjust as needed. Every value is optional and has a default.

# --- Target under test ---
BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com

# --- Runner ---
WORKERS=3
# RETRIES defaults to 2 on CI and 0 locally
RETRIES=

# --- Optional fixed primary account (otherwise one is auto-registered) ---
DEMOBLAZE_USER=
DEMOBLAZE_PASS=

# --- Performance journey (login -> add to cart -> place order) ---
PERF_ITERATIONS=3
PERF_PRODUCT=Samsung galaxy s6
# Per-step budgets in milliseconds, asserted against the median sample
PERF_LOGIN_MS=6000
PERF_ADDCART_MS=6000
PERF_ORDER_MS=8000
PERF_TOTAL_MS=18000
